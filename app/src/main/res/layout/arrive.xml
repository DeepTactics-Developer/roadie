<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="horizontal">

    <!-- 왼쪽: 오늘의 드라이브 카드 -->
    <LinearLayout
        android:layout_width="700dp"
        android:layout_height="match_parent"
        android:background="@color/panel"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:paddingVertical="40dp">

        <TextView
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오늘의 드라이브"
            android:textColor="@color/accent" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/ink"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ink"
            android:textSize="23sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.deeptactics.roadie.CarFace
                android:id="@+id/face"
                android:layout_width="150dp"
                android:layout_height="124dp" />

            <TextView
                android:id="@+id/bubble"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:background="@drawable/bg_quote"
                android:lineSpacingExtra="5dp"
                android:paddingVertical="4dp"
                android:paddingStart="20dp"
                android:textColor="@color/ink"
                android:textSize="22sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="28dp"
            android:background="@color/rule" />

        <TextView
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="도로 테이스팅 노트" />

        <TextView
            android:id="@+id/note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/ink"
            android:textSize="25sp" />

        <TextView
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="지나온 장면" />

        <TextView
            android:id="@+id/scenes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="8dp"
            android:textColor="@color/ink"
            android:textSize="22sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/record"
            style="@style/Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/home"
            style="@style/Primary"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="16dp"
            android:text="홈으로"
            android:textSize="32sp" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/rule" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <com.deeptactics.roadie.RouteView
            android:id="@+id/route"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:background="#B3FFFFFF"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="© OpenStreetMap contributors"
            android:textColor="@color/ink2"
            android:textSize="14sp" />
    </FrameLayout>
</LinearLayout>
